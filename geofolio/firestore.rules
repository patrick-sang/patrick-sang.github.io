rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    match /admins/{uid} {
      // A signed-in user can only read their own admin marker.
      allow read: if signedIn() && request.auth.uid == uid;
      // Create/change admin markers only from the Firebase Console.
      allow write: if false;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'title','type','thumbnail','technologies','description',
          'githubUrl','demoUrl','date','likes','views','createdAt',
          'updatedAt','createdBy'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        || (
          // Public visitors may only change one counter by exactly one step.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','views'])
          && (
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
              && request.resource.data.likes is int
              && resource.data.likes is int
              && (request.resource.data.likes == resource.data.likes + 1
                  || request.resource.data.likes == resource.data.likes - 1)
              && request.resource.data.likes >= 0)
            ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
              && request.resource.data.views is int
              && resource.data.views is int
              && request.resource.data.views == resource.data.views + 1)
          )
        );
      allow delete: if isAdmin();
    }
  }
}
