rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }
    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      match /likes/{uid} {
        allow read: if true;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid','createdAt'])
          && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && request.auth.uid == uid;
        allow update: if false;
      }
      match /bookmarks/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid','createdAt'])
          && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && request.auth.uid == uid;
        allow update: if false;
      }
    }
    match /experiments/{experimentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
