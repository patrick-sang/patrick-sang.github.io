  "metadata": {
    "title": "Kenya Indicative Crop Calendar",
    "version": "1.0",
    "note": "Reference windows are indicative, not farm-level prescriptions. Validate with county agricultural officers and local farmer calendars. Calendar windows vary with altitude, rainfall onset, variety and local practice.",
    "sources": [
      {
        "name": "FEWS NET Kenya Data Book",
        "url": "https://help.fews.net/fde/v3/kenya-country-book",
        "detail": "Regional seasonal patterns for unimodal, medium-altitude and eastern/coastal zones."
      },
      {
        "name": "FAO GIEWS Kenya Country Brief / Crop Calendar",
        "url": "https://www.fao.org/giews/countrybrief/country/KEN/pdf/KEN.pdf",
        "detail": "National major-foodcrop calendar; crop/season spans."
      },
      {
        "name": "Kenya Western Region planting calendar (UNCTAD-hosted document)",
        "url": "https://unctad.org/system/files/non-official-document/cw070823_p04_Kenya.pdf",
        "detail": "Western-region maize calendar; planting Feb\u2013Mar, vegetative/reproductive Mar\u2013Jun, harvest Jul\u2013Aug."
      }
    ]
  },
